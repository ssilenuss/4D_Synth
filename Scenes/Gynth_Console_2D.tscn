[node name="db_menu" type="MenuButton" parent="ScrollContainer/VBoxContainer/FilterControls/LowPassFilter/FilterControls"]
layout_mode = 2
tooltip_text = "CLIP: Digital distortion effect which cuts off peaks at the top and bottom of the waveform.

ATAN: Yet undescribed.

LoFi: Low-resolution digital distortion effect (bit depth reduction). You can use it to emulate the sound of early digital audio devices.

OverDrive: Emulates the warm distortion produced by a field effect transistor, which is commonly used in solid-state musical instrument amplifiers. The drive property has no effect in this mode.

WaveShape:  Waveshaper distortions are used mainly by electronic musicians to achieve an extra-abrasive sound.


"
text = "dB"
flat = false
item_count = 4
popup/item_0/text = "6 dB"
popup/item_0/id = 0
popup/item_1/text = "12 dB"
popup/item_1/id = 1
popup/item_2/text = "18 dB"
popup/item_2/id = 2
popup/item_3/text = "24 dB"
popup/item_3/id = 3

