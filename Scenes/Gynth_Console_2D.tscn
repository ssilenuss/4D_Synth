[node name="DistortionTitleLabel" type="Label" parent="DistortionSettings/VBoxContainer/ScrollContainer/VBoxContainer"]
layout_mode = 2
tooltip_text = "Different types are available: clip, tan, lo-fi (bit crushing), overdrive, or waveshape.

By distorting the waveform the frequency content changes, which will often make the sound \"crunchy\" or \"abrasive\". For games, it can simulate sound coming from some saturated device or speaker very efficiently."
mouse_filter = 0
text = "
DISTORTION SETTINGS"
horizontal_alignment = 1

[node name="ResetButton" type="Button" parent="DistortionSettings/VBoxContainer/ScrollContainer/VBoxContainer" node_paths=PackedStringArray("settings")]
layout_mode = 2
text = "RESET TO DEFAULTS"
script = ExtResource("4_vjg4x")
settings = [NodePath("../DriveSlider"), NodePath("../KeepHFhzSlider"), NodePath("../PreGainSlider"), NodePath("../PostGainSlider")]

[node name="SpacerLabel" type="Label" parent="DistortionSettings/VBoxContainer/ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "
"

[node name="Mode_Menu" type="MenuButton" parent="DistortionSettings/VBoxContainer/ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "CLIP: Digital distortion effect which cuts off peaks at the top and bottom of the waveform.

ATAN: Yet undescribed.

LoFi: Low-resolution digital distortion effect (bit depth reduction). You can use it to emulate the sound of early digital audio devices.

OverDrive: Emulates the warm distortion produced by a field effect transistor, which is commonly used in solid-state musical instrument amplifiers. The drive property has no effect in this mode.

WaveShape:  Waveshaper distortions are used mainly by electronic musicians to achieve an extra-abrasive sound.


"
text = "Mode"
flat = false
item_count = 5
popup/item_0/text = "Mode: Clip"
popup/item_0/id = 0
popup/item_1/text = "Mode: Atan"
popup/item_1/id = 1
popup/item_2/text = "Mode: LoFi"
popup/item_2/id = 2
popup/item_3/text = "Mode: OverDrive"
popup/item_3/id = 3
popup/item_4/text = "Mode:WaveShape"
popup/item_4/id = 4

